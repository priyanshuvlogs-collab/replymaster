# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/replymaster?schema=public"

# NextAuth.js — generate with: npx auth secret (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-secret"

# Base URL of the app (only needed behind proxies / in production)
# AUTH_URL="http://localhost:3000"
